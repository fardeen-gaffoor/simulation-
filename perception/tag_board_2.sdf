<?xml version="1.0" ?>
<!-- rover_perception: rendered AprilTag board, spawned at runtime.
     tag id 2 (tag36h11), black square 0.1800 m,
     bitmap 0.225000 m square including its quiet zone,
     mount: north_wall.  This model has no <pose>: the spawn command owns it.
     A thin <box> is used because gz-sim's <plane> has no texture
     coordinates; the visual is posed so the textured face points out of
     the wall, un-mirrored, exactly on the tag plane (see tagboard.py). -->
<sdf version="1.8">
  <model name="tag_board_2">
    <static>true</static>
    <link name="link">
      <visual name="tag">
        <pose>0.000000000 0.000000000 0.001000000 3.141592654 0.000000000 -1.570796327</pose>
        <geometry>
          <box>
            <size>0.225000 0.225000 0.002000</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
          <pbr>
            <metal>
              <albedo_map>file:///home/fewest/cat/perception/tag_2_tag36h11.png</albedo_map>
              <roughness>0.65</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
