<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_dataset</name>
  <version>0.3.0</version>
  <description>
    Module 3 of the Caterpillar Autonomy Challenge stack: the perception dataset
    toolchain.  Sim data-collection mode with domain randomization (lighting,
    sand colour, shadows, blur, noise), auto-labels projected from the module-1
    ground truth through the module-2 camera calibration, export in YOLO format,
    tools to merge real CSI-camera photographs, a labelling checklist, a
    train/val split by scene (never by frame) and fine-tuning scripts.
  </description>
  <maintainer email="team@cat-arena.local">Caterpillar Autonomy Challenge team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_cmake_pytest</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <!-- generated artefacts consumed as files (ground_truth.yaml, calibration.yaml) -->
  <exec_depend>cat_arena</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
