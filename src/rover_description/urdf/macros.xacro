<?xml version="1.0"?>
<!-- ==========================================================================
     rover_description / macros.xacro - generic, robot-agnostic xacro macros.

     Kept free of any rover-specific number: every caller passes geometry,
     colour and the key into the generated inertias table.  This is the "Xacro
     macros" deliverable of module 2.
     ========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inertial block for a link whose mass/inertia live in the generated
       inertias table under ${key}.  origin is the CoM (== geometry origin for
       our homogeneous primitives). -->
  <xacro:macro name="inertial_from_table" params="key origin:='0 0 0'">
    <inertial>
      <origin xyz="${origin}" rpy="0 0 0"/>
      <mass value="${iner[key]['mass']}"/>
      <inertia
        ixx="${iner[key]['ixx']}" ixy="${iner[key]['ixy']}" ixz="${iner[key]['ixz']}"
        iyy="${iner[key]['iyy']}" iyz="${iner[key]['iyz']}" izz="${iner[key]['izz']}"/>
    </inertial>
  </xacro:macro>

  <!-- A rigid link built from a cuboid.  size and geometry origin are xacro
       argument strings so callers read naturally. -->
  <xacro:macro name="box_link" params="name size rgba ikey geom_origin:='0 0 0'">
    <link name="${name}">
      <xacro:inertial_from_table key="${ikey}" origin="${geom_origin}"/>
      <visual>
        <origin xyz="${geom_origin}" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${geom_origin}" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- A rigid link built from a cylinder whose axis is the link +z axis. -->
  <xacro:macro name="cylinder_link" params="name radius length rgba ikey">
    <link name="${name}">
      <xacro:inertial_from_table key="${ikey}"/>
      <visual>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- A massless child link (sensor / optical frame). -->
  <xacro:macro name="frame_link" params="name">
    <link name="${name}"/>
  </xacro:macro>

  <!-- Joints -->
  <xacro:macro name="fixed_joint" params="name parent child xyz rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="continuous_joint" params="name parent child xyz rpy axis damping friction">
    <joint name="${name}" type="continuous">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <dynamics damping="${damping}" friction="${friction}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="revolute_joint" params="name parent child xyz rpy axis lower upper effort velocity damping friction">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="${damping}" friction="${friction}"/>
    </joint>
  </xacro:macro>

  <!-- A gz camera sensor with an explicit camera_info topic and optical frame.
       Attached via <gazebo reference="<parent link>">. -->
  <xacro:macro name="gz_camera" params="name topic info_topic optical_frame width height hfov_rad rate">
    <sensor name="${name}" type="camera">
      <update_rate>${rate}</update_rate>
      <topic>${topic}</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${hfov_rad}</horizontal_fov>
        <camera_info_topic>${info_topic}</camera_info_topic>
        <optical_frame_id>${optical_frame}</optical_frame_id>
        <image>
          <width>${width}</width>
          <height>${height}</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>50.0</far></clip>
        <noise><type>none</type></noise>
      </camera>
    </sensor>
  </xacro:macro>

  <!-- A gz IMU sensor (no magnetometer). -->
  <xacro:macro name="gz_imu" params="name topic rate">
    <sensor name="${name}" type="imu">
      <update_rate>${rate}</update_rate>
      <topic>${topic}</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </xacro:macro>

  <!-- Wheel contact friction. -->
  <xacro:macro name="gz_surface_friction" params="mu mu2">
    <mu1>${mu}</mu1>
    <mu2>${mu2}</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.0005</minDepth>
    <maxVel>0.05</maxVel>
  </xacro:macro>

</robot>
