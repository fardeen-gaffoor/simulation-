          Alpha: 1
          Show Axes: false
          Show Trail: false
        funnel_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        imu_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        ladder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        tub_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        wheel_front_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
