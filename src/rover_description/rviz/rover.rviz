          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        wheel_rear_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        wheel_rear_right:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        base_link:
          Value: true
        belt_link:
          Value: true
        cam_dump_link:
          Value: true
        cam_dump_optical_frame:
          Value: true
        cam_excavation_link:
          Value: true
        cam_excavation_optical_frame:
          Value: true
        cam_nav_link:
          Value: true
